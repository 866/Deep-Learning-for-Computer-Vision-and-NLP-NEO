{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "@webgpu/types"],
    "paths": {
      "@/src/*": ["./src/*"],
      "@/styles/*": ["./styles/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
